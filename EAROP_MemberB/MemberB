import java.util.ArrayList;
import java.util.Arrays;

public class EmergencyAmbulanceOptimization {

    // ============================================
    // Insertion Sort
    // ============================================
    public static String insertionSort(int[] arr) {

        if (arr == null || arr.length == 0) {
            return "Invalid: array is empty";
        }

        for (int i = 1; i < arr.length; i++) {

            int key = arr[i];
            int j = i - 1;

            while (j >= 0 && arr[j] > key) {
                arr[j + 1] = arr[j];
                j--;
            }

            arr[j + 1] = key;
        }

        return Arrays.toString(arr);
    }

    // ============================================
    // Binary Search
    // ============================================
    public static String binarySearch(int[] arr, int target) {

        // Data validation
        if (arr == null || arr.length == 0) {
            return "Invalid: array is empty";
        }

        // Binary Search requires a sorted array
        for (int i = 1; i < arr.length; i++) {
            if (arr[i - 1] > arr[i]) {
                return "Invalid: array must be sorted";
            }
        }

        int low = 0;
        int high = arr.length - 1;

        while (low <= high) {

            int mid = low + (high - low) / 2;

            if (arr[mid] == target) {
                return String.valueOf(mid);
            } else if (arr[mid] < target) {
                low = mid + 1;
            } else {
                high = mid - 1;
            }
        }

        return "Not found";
    }

    // ============================================
    // Min-Heap
    // ============================================
    static class MinHeap {

        private ArrayList<Integer> heap;

        public MinHeap() {
            heap = new ArrayList<>();
        }

        // --------------------------------------------
        // Get Parent Index
        // --------------------------------------------
        private int getParentIndex(int i) {
            return (i - 1) / 2;
        }

        // --------------------------------------------
        // Get Left Child Index
        // --------------------------------------------
        private int getLeftChildIndex(int i) {
            return (2 * i) + 1;
        }

        // --------------------------------------------
        // Get Right Child Index
        // --------------------------------------------
        private int getRightChildIndex(int i) {
            return (2 * i) + 2;
        }

        // --------------------------------------------
        // Swap Two Elements
        // --------------------------------------------
        private void swap(int index1, int index2) {

            int temp = heap.get(index1);

            heap.set(index1, heap.get(index2));
            heap.set(index2, temp);
        }

        // --------------------------------------------
        // Insert
        // --------------------------------------------
        public void insert(int element) {

            heap.add(element);

            heapifyUp(heap.size() - 1);
        }

        // --------------------------------------------
        // Heapify Up
        // --------------------------------------------
        private void heapifyUp(int index) {

            while (index > 0
                    && heap.get(index)
                    < heap.get(getParentIndex(index))) {

                int parentIndex = getParentIndex(index);

                swap(index, parentIndex);

                index = parentIndex;
            }
        }

        // --------------------------------------------
        // Extract Minimum
        // --------------------------------------------
        public int extractMin() {

            if (heap.isEmpty()) {
                System.out.println("Heap is empty!");
                return -1;
            }

            int minValue = heap.get(0);

            int lastValue = heap.remove(heap.size() - 1);

            if (!heap.isEmpty()) {

                heap.set(0, lastValue);

                heapifyDown(0);
            }

            return minValue;
        }

        // --------------------------------------------
        // Heapify Down
        // --------------------------------------------
        private void heapifyDown(int index) {

            int smallest = index;

            int left = getLeftChildIndex(index);
            int right = getRightChildIndex(index);

            if (left < heap.size()
                    && heap.get(left) < heap.get(smallest)) {

                smallest = left;
            }

            if (right < heap.size()
                    && heap.get(right) < heap.get(smallest)) {

                smallest = right;
            }

            if (smallest != index) {

                swap(index, smallest);

                heapifyDown(smallest);
            }
        }

        // --------------------------------------------
        // Display Heap
        // --------------------------------------------
        public void printHeap() {

            System.out.println(heap);
        }
    }

    // ============================================
    // Splay Tree
    // ============================================
    static class SplayTree {

        // --------------------------------------------
        // Node
        // --------------------------------------------
        static class Node {

            int key;
            Node left;
            Node right;

            Node(int key) {

                this.key = key;
                this.left = null;
                this.right = null;
            }
        }

        private Node root;

        // --------------------------------------------
        // Right Rotation
        // --------------------------------------------
        private Node rightRotate(Node x) {

            Node y = x.left;

            x.left = y.right;
            y.right = x;

            return y;
        }

        // --------------------------------------------
        // Left Rotation
        // --------------------------------------------
        private Node leftRotate(Node x) {

            Node y = x.right;

            x.right = y.left;
            y.left = x;

            return y;
        }

        // --------------------------------------------
        // Splay Operation
        // --------------------------------------------
        private Node splay(Node root, int key) {

            if (root == null || root.key == key) {
                return root;
            }

            // Key is in the left subtree
            if (root.key > key) {

                if (root.left == null) {
                    return root;
                }

                // Zig-Zig
                if (root.left.key > key) {

                    root.left.left =
                            splay(root.left.left, key);

                    root = rightRotate(root);
                }

                // Zig-Zag
                else if (root.left.key < key) {

                    root.left.right =
                            splay(root.left.right, key);

                    if (root.left.right != null) {
                        root.left =
                                leftRotate(root.left);
                    }
                }

                return (root.left == null)
                        ? root
                        : rightRotate(root);
            }

            // Key is in the right subtree
            else {

                if (root.right == null) {
                    return root;
                }

                // Zag-Zig
                if (root.right.key > key) {

                    root.right.left =
                            splay(root.right.left, key);

                    if (root.right.left != null) {
                        root.right =
                                rightRotate(root.right);
                    }
                }

                // Zag-Zag
                else if (root.right.key < key) {

                    root.right.right =
                            splay(root.right.right, key);

                    root = leftRotate(root);
                }

                return (root.right == null)
                        ? root
                        : leftRotate(root);
            }
        }

        // --------------------------------------------
        // Search
        // --------------------------------------------
        public boolean search(int key) {

            root = splay(root, key);

            return root != null && root.key == key;
        }

        // --------------------------------------------
        // Insert
        // --------------------------------------------
        public void insert(int key) {

            if (root == null) {

                root = new Node(key);

                return;
            }

            root = splay(root, key);

            // Avoid duplicate values
            if (root.key == key) {
                return;
            }

            Node newNode = new Node(key);

            if (root.key > key) {

                newNode.right = root;
                newNode.left = root.left;

                root.left = null;

            } else {

                newNode.left = root;
                newNode.right = root.right;

                root.right = null;
            }

            root = newNode;
        }

        // --------------------------------------------
        // Display Current Root
        // --------------------------------------------
        public void printRoot() {

            if (root != null) {

                System.out.println(
                        "Current Splay Tree Root Node: "
                        + root.key
                );

            } else {

                System.out.println("Tree is empty");
            }
        }
    }

    // ============================================
    // Main Method
    // ============================================
    public static void main(String[] args) {

        // ============================================
        // Insertion Sort & Binary Search
        // ============================================
        System.out.println("===== SORTING & SEARCHING =====");

        int[] arr = {8, 3, 5, 1, 9, 2};

        insertionSort(arr);

        System.out.println(
                "Sorted Emergency Response Times: "
                + Arrays.toString(arr)
        );

        System.out.println(
                "Binary Search (Response Time 5 found at index): "
                + binarySearch(arr, 5)
        );

        System.out.println(
                "Binary Search (Response Time 7 found at index): "
                + binarySearch(arr, 7)
        );

        // ============================================
        // Min-Heap
        // ============================================
        System.out.println();
        System.out.println("===== MIN-HEAP =====");

        MinHeap heap = new MinHeap();

        heap.insert(10);
        heap.insert(3);
        heap.insert(15);

        System.out.print(
                "Current Min-Heap Structure: "
        );

        heap.printHeap();

        System.out.println(
                "Min-Heap Extract Minimum: "
                + heap.extractMin()
        );

        System.out.print(
                "Min-Heap Structure After Extraction: "
        );

        heap.printHeap();

        // ============================================
        // Splay Tree
        // ============================================
        System.out.println();
        System.out.println("===== SPLAY TREE =====");

        SplayTree tree = new SplayTree();

        tree.insert(20);
        tree.insert(10);
        tree.insert(30);

        tree.printRoot();

        System.out.println(
                "Splay Tree Search (10 found): "
                + tree.search(10)
        );

        tree.printRoot();
    }
}
